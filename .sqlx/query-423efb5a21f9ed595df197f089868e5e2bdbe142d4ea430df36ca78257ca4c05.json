  "query": "\n        SELECT id, name, name_ar, parent_id, notes, created_at, updated_at\n        FROM categories\n        WHERE name ILIKE $1 OR name_ar ILIKE $1\n        ORDER BY name_ar ASC\n        LIMIT 10\n        ",
