{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE products\n        SET \n            name = COALESCE($1, name),\n            name_ar = COALESCE($2, name_ar),\n            category_id = COALESCE($3, category_id),\n            notes = CASE \n                WHEN $4::boolean THEN $5 \n                ELSE notes \n            END,\n            updated_at = NOW()\n        WHERE id = $6\n        RETURNING id, name, name_ar, category_id, notes, created_at, updated_at\n        ",
